        <mxCell id="s2b" edge="1" parent="capa-washington" source="j2sp5MnRYfw1ipF6x_JL-16" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#000000;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1.0;exitY=0.3438;entryX=0.0;entryY=0.8125;exitDx=0;exitDy=0;exitPerimeter=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="j2sp5MnRYfw1ipF6x_JL-18" value="&lt;b&gt;S2b&lt;/b&gt; · Registrar aviso con URL/ID de imagen&lt;br&gt;&lt;b&gt;REST API · HTTPS/TCP · síncrona&lt;/b&gt;&lt;br&gt;&lt;i&gt;↩ PUB vincula la imagen con el aviso&lt;/i&gt;">
