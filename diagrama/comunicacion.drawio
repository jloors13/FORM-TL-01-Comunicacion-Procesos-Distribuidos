        </mxCell>
        <mxCell id="n-r3-alerta" parent="capa-washington" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=16;" value="&lt;b&gt;[R3]&lt;/b&gt; Alerta de seguridad: ruta prioritaria; objetivo &amp;lt;1 s. Tópico alertas.seguridad con consumidores dedicados en MUR y NOT." vertex="1">
          <mxGeometry x="1745" y="572" width="270" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n-f2" parent="capa-washington" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=16;" value="&lt;b&gt;[F2]&lt;/b&gt; Si MUR cae, el evento no confirmado se reintenta al recuperarse; consumidor idempotente para evitar duplicados." vertex="1">
