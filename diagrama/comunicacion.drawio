        <mxCell id="ley-e-front-t" value="Frontera del sistema Vecindario" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
