        <mxCell id="s4b" edge="1" parent="capa-cesar" source="zv-97ObwJ9qFjEp7vpU8-11" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#000000;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;startArrow=classic;startFill=1;startSize=7;exitX=1.0;exitY=0.3333;entryX=0.0;entryY=0.3867;exitDx=0;exitDy=0;exitPerimeter=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="j2sp5MnRYfw1ipF6x_JL-24" value="&lt;b&gt;S4&lt;/b&gt; · conexión asignada a una instancia sana&lt;br&gt;&lt;b&gt;WSS/TCP · bidireccional&lt;/b&gt;">
