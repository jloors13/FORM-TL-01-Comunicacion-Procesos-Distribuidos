        <mxCell id="ops" value="" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" vertex="1" parent="1">
          <mxGeometry x="1326" y="1462" width="480" height="172" as="geometry" />
        </mxCell>
        <mxCell id="ops-h" value="Operaciones del enunciado → interacciones" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1338" y="1466" width="456" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ops-t" value="&lt;b&gt;(a)&lt;/b&gt; Publicar un aviso con imagen: S1 → S2 → S2b → A1&lt;br&gt;&lt;b&gt;(b)&lt;/b&gt; Distribuir el aviso al muro de los seguidores: A1 → A2 → S3 (por lotes); el seguidor lee su muro con S10; aviso push A3 → A5&lt;br&gt;&lt;b&gt;(c)&lt;/b&gt; Enviar y recibir mensajes directos: S4 → S6 (persistir antes del ACK) → ACK y entrega por S4&lt;br&gt;&lt;b&gt;(d)&lt;/b&gt; Mostrar quién está en línea: S5 → S7 (presencia con TTL)&lt;br&gt;&lt;b&gt;(e)&lt;/b&gt; Denunciar una publicación y ocultarla: S8 → S9 → A4 (invalidar muros)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1338" y="1492" width="456" height="136" as="geometry" />
        </mxCell>
        <mxCell id="sup" value="" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" vertex="1" parent="1">
          <mxGeometry x="1822" y="1462" width="477" height="172" as="geometry" />
        </mxCell>
        <mxCell id="sup-h" value="Por qué distribuido y decisiones del equipo" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1834" y="1466" width="453" height="22" as="geometry" />
        </mxCell>
        <mxCell id="sup-t" value="• 200.000 usuarios y hasta 40.000 conectados (R1); la mensajería exige 99,5 % (R6) y el muro puede degradarse sin afectarla: por eso cada servicio escala y falla por separado.&lt;br&gt;• Kafka, PostgreSQL, Redis, balanceador, REST, gRPC y FCM son decisiones del equipo para cumplir R1–R6; el enunciado no las impone.&lt;br&gt;• Cada servicio guarda sus datos en su propia base; solo se dibujan las bases que intervienen en la comunicación." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1834" y="1492" width="453" height="136" as="geometry" />
        </mxCell>
        <mxCell id="capa-washington" parent="0" value="Flujo de publicación, muro y notificaciones (responsable: Washington Apunte)" />
