        </mxCell>
        <mxCell id="n-r1r6" parent="capa-cesar" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=16;" value="&lt;b&gt;[R1] [R6]&lt;/b&gt; Varias instancias detrás del balanceador; health checks; objetivo de disponibilidad 99,5 %. Reparten las 40.000 conexiones simultáneas; MSG no depende de MUR, así que si el muro se degrada la mensajería sigue." vertex="1">
          <mxGeometry x="900" y="1188" width="268" height="112" as="geometry" />
        </mxCell>
        <mxCell id="n-r2" parent="capa-cesar" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=16;" value="&lt;b&gt;[R2]&lt;/b&gt; Entrega &amp;lt;500 ms por el canal WSS ya abierto. message_id único para deduplicación; sequence_no creciente por conversación para conservar orden." vertex="1">
          <mxGeometry x="565" y="1210" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n-f1f3" parent="capa-cesar" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=16;" value="&lt;b&gt;[F1] [F3]&lt;/b&gt; Persistir antes de ACK; mensajes pendientes sobreviven a desconexión/reinicio.&lt;br&gt;&lt;b&gt;F1:&lt;/b&gt; si el destinatario está desconectado, el mensaje queda en PostgreSQL y se entrega al reconectar, desde su último ACK.&lt;br&gt;&lt;b&gt;F3:&lt;/b&gt; si MSG se reinicia, el cliente reconecta por el balanceador a otra instancia y recupera desde su último sequence_no; message_id evita duplicados." vertex="1">
          <mxGeometry x="905" y="1314" width="460" height="114" as="geometry" />
        </mxCell>
        <mxCell id="n-redis" parent="capa-cesar" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=16;" value="Presencia temporal; heartbeat renueva TTL; expiración detecta desconexión." vertex="1">
          <mxGeometry height="100" width="205" x="1815" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="n-r5" parent="capa-cesar" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=16;" value="&lt;b&gt;[R5]&lt;/b&gt; Al llegar a tres denuncias válidas, ocultar en menos de 1 minuto." vertex="1">
